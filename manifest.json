{
  "manifest_version": 3,
  "name": "Sidebar Arcade — 15 Game",
  "short_name": "Sidebar Arcade",
  "version": "1.0.0",
  "description": "15 game mini yang bisa langsung dimainkan di Chrome Side Panel. Ringan, offline, tanpa iklan.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "action": {
    "default_title": "Buka Sidebar Arcade",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
